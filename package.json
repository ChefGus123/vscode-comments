{
  "name": "agentic-comments",
  "displayName": "Agentic Comments",
  "description": "Leave GitHub-style inline review comments on live code and expose them to AI coding agents via MCP.",
  "version": "0.4.5",
  "publisher": "IlayAmir",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#14162A",
    "theme": "dark"
  },
  "homepage": "https://github.com/ChefGus123/vscode-comments#readme",
  "bugs": {
    "url": "https://github.com/ChefGus123/vscode-comments/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChefGus123/vscode-comments.git"
  },
  "license": "ISC",
  "author": "Ilay Amir",
  "type": "commonjs",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "agentComments.addComment",
        "title": "Add Comment",
        "category": "Agentic Comments"
      },
      {
        "command": "agentComments.resolveComment",
        "title": "Resolve",
        "category": "Agentic Comments",
        "icon": "$(check)"
      },
      {
        "command": "agentComments.reopenComment",
        "title": "Reopen",
        "category": "Agentic Comments",
        "icon": "$(discard)"
      },
      {
        "command": "agentComments.deleteComment",
        "title": "Delete",
        "category": "Agentic Comments",
        "icon": "$(trash)"
      },
      {
        "command": "agentComments.editComment",
        "title": "Edit",
        "category": "Agentic Comments",
        "icon": "$(edit)"
      },
      {
        "command": "agentComments.saveComment",
        "title": "Save",
        "category": "Agentic Comments"
      },
      {
        "command": "agentComments.cancelEditComment",
        "title": "Cancel",
        "category": "Agentic Comments"
      },
      {
        "command": "agentComments.revealComment",
        "title": "Reveal Comment",
        "category": "Agentic Comments"
      },
      {
        "command": "agentComments.clearStorage",
        "title": "Clear All Comment Data for This Workspace",
        "category": "Agentic Comments"
      },
      {
        "command": "agentComments.refreshTree",
        "title": "Refresh",
        "category": "Agentic Comments",
        "icon": "$(refresh)"
      },
      {
        "command": "agentComments.showResolved",
        "title": "Show Resolved Comments",
        "category": "Agentic Comments",
        "icon": "$(eye)"
      },
      {
        "command": "agentComments.hideResolved",
        "title": "Hide Resolved Comments",
        "category": "Agentic Comments",
        "icon": "$(eye-closed)"
      },
      {
        "command": "agentComments.resolveCommentInTree",
        "title": "Resolve",
        "category": "Agentic Comments",
        "icon": "$(check)"
      },
      {
        "command": "agentComments.reopenCommentInTree",
        "title": "Reopen",
        "category": "Agentic Comments",
        "icon": "$(discard)"
      },
      {
        "command": "agentComments.deleteCommentInTree",
        "title": "Delete",
        "category": "Agentic Comments",
        "icon": "$(trash)"
      },
      {
        "command": "agentComments.addCommentAtSelection",
        "title": "Add Comment",
        "category": "Agentic Comments"
      },
      {
        "command": "agentComments.addCommentFromPreview",
        "title": "Add Comment",
        "category": "Agentic Comments"
      },
      {
        "command": "agentComments.editCommentFromPreview",
        "title": "Edit Comment",
        "category": "Agentic Comments",
        "icon": "$(edit)"
      },
      {
        "command": "agentComments.resolveCommentFromPreview",
        "title": "Resolve Comment",
        "category": "Agentic Comments",
        "icon": "$(check)"
      },
      {
        "command": "agentComments.reopenCommentFromPreview",
        "title": "Reopen Comment",
        "category": "Agentic Comments",
        "icon": "$(discard)"
      },
      {
        "command": "agentComments.deleteCommentFromPreview",
        "title": "Delete Comment",
        "category": "Agentic Comments",
        "icon": "$(trash)"
      }
    ],
    "markdown.markdownItPlugins": true,
    "markdown.previewScripts": [
      "./media/preview.js"
    ],
    "markdown.previewStyles": [
      "./media/preview.css"
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "agentComments.addComment",
          "when": "false"
        },
        {
          "command": "agentComments.resolveComment",
          "when": "false"
        },
        {
          "command": "agentComments.reopenComment",
          "when": "false"
        },
        {
          "command": "agentComments.deleteComment",
          "when": "false"
        },
        {
          "command": "agentComments.editComment",
          "when": "false"
        },
        {
          "command": "agentComments.saveComment",
          "when": "false"
        },
        {
          "command": "agentComments.cancelEditComment",
          "when": "false"
        },
        {
          "command": "agentComments.revealComment",
          "when": "false"
        },
        {
          "command": "agentComments.resolveCommentInTree",
          "when": "false"
        },
        {
          "command": "agentComments.reopenCommentInTree",
          "when": "false"
        },
        {
          "command": "agentComments.deleteCommentInTree",
          "when": "false"
        },
        {
          "command": "agentComments.addCommentFromPreview",
          "when": "false"
        },
        {
          "command": "agentComments.editCommentFromPreview",
          "when": "false"
        },
        {
          "command": "agentComments.resolveCommentFromPreview",
          "when": "false"
        },
        {
          "command": "agentComments.reopenCommentFromPreview",
          "when": "false"
        },
        {
          "command": "agentComments.deleteCommentFromPreview",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "agentComments.addCommentFromPreview",
          "group": "9_comment",
          "when": "webviewSection == 'agentCommentsPreviewTarget'"
        },
        {
          "command": "agentComments.editCommentFromPreview",
          "group": "9_comment_actions",
          "when": "(webviewSection == 'agentCommentsPreviewTarget' || webviewSection == 'agentCommentsPanelRowTarget') && agentCommentsCommentIds != '' && agentCommentsHasUnresolved == 'true'"
        },
        {
          "command": "agentComments.resolveCommentFromPreview",
          "group": "9_comment_actions",
          "when": "(webviewSection == 'agentCommentsPreviewTarget' || webviewSection == 'agentCommentsPanelRowTarget') && agentCommentsCommentIds != '' && agentCommentsHasUnresolved == 'true'"
        },
        {
          "command": "agentComments.reopenCommentFromPreview",
          "group": "9_comment_actions",
          "when": "(webviewSection == 'agentCommentsPreviewTarget' || webviewSection == 'agentCommentsPanelRowTarget') && agentCommentsCommentIds != '' && agentCommentsHasResolved == 'true'"
        },
        {
          "command": "agentComments.deleteCommentFromPreview",
          "group": "9_comment_actions",
          "when": "(webviewSection == 'agentCommentsPreviewTarget' || webviewSection == 'agentCommentsPanelRowTarget') && agentCommentsCommentIds != ''"
        }
      ],
      "editor/context": [
        {
          "command": "agentComments.addCommentAtSelection",
          "group": "9_comment",
          "when": "editorTextFocus && resourceScheme == file"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "agentComments.addComment",
          "group": "inline",
          "when": "commentController == agentComments"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "agentComments.resolveComment",
          "group": "inline",
          "when": "commentController == agentComments && commentThread == unresolved"
        },
        {
          "command": "agentComments.reopenComment",
          "group": "inline",
          "when": "commentController == agentComments && commentThread == resolved"
        },
        {
          "command": "agentComments.deleteComment",
          "group": "inline",
          "when": "commentController == agentComments && (commentThread == unresolved || commentThread == resolved)"
        }
      ],
      "comments/comment/title": [
        {
          "command": "agentComments.editComment",
          "group": "inline",
          "when": "commentController == agentComments && comment == editable"
        }
      ],
      "comments/comment/context": [
        {
          "command": "agentComments.saveComment",
          "group": "inline@1",
          "when": "commentController == agentComments"
        },
        {
          "command": "agentComments.cancelEditComment",
          "group": "inline@2",
          "when": "commentController == agentComments"
        }
      ],
      "view/title": [
        {
          "command": "agentComments.refreshTree",
          "when": "view == agentCommentsView",
          "group": "navigation@1"
        },
        {
          "command": "agentComments.showResolved",
          "when": "view == agentCommentsView && !agentComments.showResolved",
          "group": "navigation@2"
        },
        {
          "command": "agentComments.hideResolved",
          "when": "view == agentCommentsView && agentComments.showResolved",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "agentComments.resolveCommentInTree",
          "when": "view == agentCommentsView && viewItem == agentCommentsCommentUnresolved",
          "group": "inline"
        },
        {
          "command": "agentComments.reopenCommentInTree",
          "when": "view == agentCommentsView && viewItem == agentCommentsCommentResolved",
          "group": "inline"
        },
        {
          "command": "agentComments.deleteCommentInTree",
          "when": "view == agentCommentsView && (viewItem == agentCommentsCommentUnresolved || viewItem == agentCommentsCommentResolved)",
          "group": "inline"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentComments",
          "title": "Agentic Comments",
          "icon": "media/comment-icon.svg"
        }
      ]
    },
    "views": {
      "agentComments": [
        {
          "id": "agentCommentsView",
          "name": "Comments"
        }
      ]
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "agentComments.mcpProvider",
        "label": "Agentic Comments"
      }
    ],
    "configuration": {
      "title": "Agentic Comments",
      "properties": {
        "agenticComments.editor.hideResolvedComments": {
          "type": "boolean",
          "default": true,
          "description": "Hide resolved comments from the editor gutter to reduce clutter. They remain accessible from the Agentic Comments sidebar with Show Resolved on."
        },
        "agenticComments.mcp.alwaysIncludeSnippet": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Experimental. Include the original commented-on code snippet (`originalContent`) on every MCP comment response, not just ones with an uncertain anchor location — saves an agent a round trip to read the file. Turn off to only include it when `locationUncertain` is true."
        },
        "agenticComments.mcp.snippetMaxChars": {
          "type": "number",
          "default": 500,
          "minimum": 0,
          "description": "Maximum characters of the original-code snippet included in MCP comment responses before truncation. Set to 0 to omit the snippet entirely."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p ./",
    "compile": "npm run typecheck && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run typecheck && node esbuild.js --production",
    "vscode:prepublish": "npm run package",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "vsix": "npm run clean && vsce package",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "^3.9.2",
    "babel-jest": "^30.4.1",
    "esbuild": "^0.24.0",
    "jest": "^30.4.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.24.1"
  }
}
